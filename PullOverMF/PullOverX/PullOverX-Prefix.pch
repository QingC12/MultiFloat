    //   · MFLog(NSString *, ...) —— 正常运行时使用
    void MFLog(NSString *format, ...) NS_FORMAT_FUNCTION(1, 2);

    // 【MF 0.1.3】Stheno 风格圆盘选择器（边缘手势呼出）
    void MFRingPickerInstall(void);
