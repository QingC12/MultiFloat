//

#ifdef __OBJC__
    #import <Foundation/Foundation.h>
#endif

// ===== 【MF】跨文件 C 接口 —— 必须 extern "C" 包裹 =====
// ⚠️ 血的教训（PullOverMF 0.1.2 / 0.1.3 连续两版整个 tweak 不加载）：
//   PullOverX.mm 是 **ObjC++**，调用没有 extern "C" 的 C 函数时，符号会被 C++ 名字修饰：
//   实测 dylib 的未定义符号里出现
//       __Z9MFLogRawCPKc          (MFLogRawC(char const*))
//       __Z19MFRingPickerInstallv (MFRingPickerInstall())
//   而 MFDebugLog.m / MFRingPicker.m 导出的是 C 名字 _MFLogRawC / _MFRingPickerInstall
//   → dyld 解析不到 → **dylib 加载失败** → 手柄消失、日志文件不生成、圆盘装不上。
//   （与 MultiFloat 时期"给 Swift 调的 C 头必须 extern C"是同一个坑。）
#ifdef __cplusplus
extern "C" {
#endif

// 纯 C 日志：constructor 阶段唯一安全入口（零 Foundation 依赖）
void MFLogRawC(const char *message);

// Stheno 风格圆盘选择器：由 constructor 延迟调用安装
void MFRingPickerInstall(void);

#ifdef __OBJC__

// 常规日志（正常运行时使用）
void MFLog(NSString *format, ...) NS_FORMAT_FUNCTION(1, 2);

#endif

#ifdef __cplusplus
}
#endif
